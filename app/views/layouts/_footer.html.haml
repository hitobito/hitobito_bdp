:plain 
  <svg xmlns="http://www.w3.org/2000/svg" xml:space="preserve"
    style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2"
    viewBox="0 0 1930 124">
    <path class="footer-swoosh" d="M755.014 2389.963s873.132 70.321 1296.56 92.168c51.18 2.641 89.606 3.749 131.493 2.997 40.079-.72 75.979-1.267 119.831-7.508 172.595-24.566 384.463-85.437 384.463-85.437l-.466 122.437-1931.888.357z" transform="translate(-755.007 -2389.963)"/>
  </svg>

%footer#page-footer
  .container-fluid
    .row
      - footer = Settings.application.footer
      - if footer.logo_image.present?
        .col
          = link_to wagon_image_pack_tag(footer.logo_image), footer.logo_url, target: '_blank'
      - else
        .margin-left-col
      .footer-content.col-9
        %p
          - footer.links.to_hash.fetch(I18n.locale, footer.links.to_hash).each do |label, url|
            = link_to label, url, target: '_blank'
            %br/
        %p
          = render_changelog_link
  = yield(:footer) if content_for?(:footer)
